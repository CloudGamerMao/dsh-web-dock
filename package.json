{
  "name": "dsh-web-dock",
  "version": "0.1.0",
  "description": "DSH plugin: dock web apps (built-in: DeepSeek Web) into the DSH UI via a same-origin reverse proxy + Service Worker. Supports in-place login, chat, session persistence and diagnostics.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "node --check lib/index.js && node --check lib/client.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CloudGamerMao/dsh-web-dock.git"
  },
  "homepage": "https://github.com/CloudGamerMao/dsh-web-dock#readme",
  "bugs": {
    "url": "https://github.com/CloudGamerMao/dsh-web-dock/issues"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-runtime"]
    }
  },
  "license": "MIT",
  "keywords": ["dsh", "deepseek", "web-dock", "embed", "plugin", "proxy", "poc"]
}
